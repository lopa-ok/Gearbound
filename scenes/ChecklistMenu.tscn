[node name="StoryText" type="RichTextLabel" parent="StoryOverlay/PanelContainer/RootMargin/RootVBox"]
layout_mode = 2
size_flags_vertical = 3
text = "You wake up in a quiet house that isn’t quite your own. Some doors are locked, others are blocked, and the only way forward is to think like two people at once.

As the human, explore, search, and reach. As the RC car, slip through cracks, scout ahead, and carry what hands can’t.

Find the tools, unlock the paths, and piece together a way out. Your checklist tracks the plan—but the story is yours to write."
