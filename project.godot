; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Move faster"
run/main_scene="uid://f7uy8ai71bmr"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

BgMusic="*res://scenes/BgMusic.tscn"
Transition="*res://scenes/Transition.tscn"
InputActions="*res://scenes/scripts/InputActions.gd"
CrosshairUI="*res://scenes/scripts/ui/CrosshairUI.gd"
PickupTracker="*res://scenes/scripts/ui/PickupTracker.gd"
CamTransition="*res://scenes/scripts/ui/CamTransition.gd"
PlayerSwitcher="*res://scenes/scripts/PlayerSwitcher.gd"
PauseManager="*res://scenes/scripts/ui/PauseManager.gd"
InputDeviceManager="*res://scenes/scripts/core/InputDeviceManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="WakatimePlugin"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[game]

video/crt_overlay_enabled=true
video/crt_effect_strength=1.0
video/crt_noise_amount=0.072
video/crt_flicker_amount=0.028

[global_group]

player=""
item_spawn=""

[gui]

theme/custom_font="uid://b6vcdxebt273f"

